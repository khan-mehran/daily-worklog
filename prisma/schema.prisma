// The GET List database. Apply changes with `npm run db:migrate`.
//
// Conventions:
// - Ids are UUIDs generated by the database client.
// - Calendar days (task dates, week bounds, project dates) are DATE columns. Prisma reads them
//   as midnight UTC, which is what src/lib/reports/iso-week.ts expects.
// - Two indexes can't be expressed here and live in the first migration's SQL: the
//   case-insensitive unique department name, and one synced task per person, project and day.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Declared in seniority order: lists sorted by role rely on it.
enum Role {
  SUPER_ADMIN
  CEO
  MANAGER
  TEAM_LEAD
  DEVELOPER
}

/// Whether a Super Admin has let this person in. Someone who signs in with Microsoft for the
/// first time starts as PENDING.
enum Approval {
  PENDING
  APPROVED
  REJECTED
}

enum Theme {
  light
  dark
  system
}

enum DepartmentStatus {
  Active
  Archived
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  LEAD_APPROVED
  MANAGER_APPROVED
  CHANGES_REQUESTED
}

enum TrailAction {
  SUBMITTED
  LEAD_APPROVED
  MANAGER_APPROVED
  CEO_ACKNOWLEDGED
  CHANGES_REQUESTED
}

enum TaskSource {
  manual
  sync
}

enum SyncOrigin {
  items
  activity
}

enum NotificationType {
  USER_PENDING
  DEPARTMENT_ASSIGNED
  DEPARTMENT_UNASSIGNED
  PROJECT_ASSIGNED
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_ACKNOWLEDGED
  REPORT_CHANGES_REQUESTED
  REMINDER
  SECURITY_ALERT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  /// Always stored lower-case. People sign in with the Microsoft account that has this address.
  email              String    @unique
  role               Role
  approval           Approval  @default(APPROVED)
  reportsTo          String?   @db.Uuid
  departmentId       String?   @db.Uuid
  /// One of PALETTE in src/lib/constants.ts.
  avatarColor        String    @default("teal")
  isActive           Boolean   @default(true)
  theme              Theme     @default(system)
  emailNotifications Boolean   @default(true)
  inAppNotifications Boolean   @default(true)
  /// When the one-time VS Code sync setup popup was shown. Null until then.
  syncGuideSeenAt    DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  approver      User?       @relation("ReportsTo", fields: [reportsTo], references: [id], onDelete: SetNull)
  directReports User[]      @relation("ReportsTo")
  department    Department? @relation("DepartmentPeople", fields: [departmentId], references: [id], onDelete: SetNull)

  managedDepartment  Department?        @relation("DepartmentManager")
  createdDepartments Department[]       @relation("DepartmentCreator")
  ownedProjects      Project[]          @relation("ProjectOwner")
  createdProjects    Project[]          @relation("ProjectCreator")
  memberships        ProjectMember[]
  tasks              Task[]
  taskTemplates      TaskTemplate[]
  reports            WeeklyReport[]     @relation("ReportOwner")
  reportsToReview    WeeklyReport[]     @relation("ReportApprover")
  trailEntries       ReportTrailEntry[]
  notifications      Notification[]
  apiTokens          ApiToken[]
  auditLogs          AuditLog[]

  @@index([departmentId, role])
  @@index([reportsTo])
  @@index([approval])
}

model Department {
  id          String           @id @default(uuid()) @db.Uuid
  /// Unique whatever its case: see the migration SQL.
  name        String
  /// Always stored upper-case.
  code        String           @unique
  description String           @default("")
  color       String
  /// Unique, so nobody manages two departments.
  managerId   String?          @unique @db.Uuid
  status      DepartmentStatus @default(Active)
  createdBy   String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  manager User? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  creator User? @relation("DepartmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  people        User[]         @relation("DepartmentPeople")
  projects      Project[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  reports       WeeklyReport[]
  notifications Notification[]

  @@index([status, name])
}

model Project {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @db.Uuid
  name         String
  /// Always stored upper-case. Unique within its department.
  code         String
  description  String    @default("")
  color        String
  /// One of PROJECT_STATUSES in src/lib/constants.ts.
  status       String    @default("Active")
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  /// The Bitbucket repository the dependency audit reads: "workspace/repo", or
  /// "workspace/repo/folder" when package-lock.json isn't at the top. Null means not audited.
  repository   String?
  ownerId      String    @db.Uuid
  createdBy    String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  owner      User       @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator    User       @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  audit         ProjectAudit?
  members       ProjectMember[]
  tasks         Task[]
  taskTemplates TaskTemplate[]
  reportTotals  ReportProjectTotal[]

  @@unique([departmentId, code])
  @@index([departmentId, status])
}

/// The latest dependency audit of a project's repository. See src/lib/audit/service.ts.
model ProjectAudit {
  projectId   String    @id @db.Uuid
  /// One of AUDIT_STATUSES in src/lib/constants.ts: the result of the last check that worked.
  status      String
  critical    Int       @default(0)
  high        Int       @default(0)
  moderate    Int       @default(0)
  low         Int       @default(0)
  /// The vulnerable packages, worst first: AuditFinding[] in src/lib/audit/advisories.ts.
  findings    Json      @default("[]")
  /// When a check last worked. Null until one has.
  checkedAt   DateTime? @db.Timestamptz(3)
  /// When a check was last tried.
  attemptedAt DateTime  @db.Timestamptz(3)
  /// Why the last try failed. Null when it worked. The fields above then still hold the last result.
  error       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([attemptedAt])
}

/// Who is assigned to a project.
model ProjectMember {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model WeeklyReport {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  departmentId      String       @db.Uuid
  isoYear           Int
  isoWeek           Int
  weekStart         DateTime     @db.Date
  weekEnd           DateTime     @db.Date
  status            ReportStatus @default(DRAFT)
  currentApproverId String?      @db.Uuid
  submittedAt       DateTime?    @db.Timestamptz(3)
  leadApprovedAt    DateTime?    @db.Timestamptz(3)
  managerApprovedAt DateTime?    @db.Timestamptz(3)
  // Totals cached from the report's tasks by recomputeTotals.
  totalHours        Float        @default(0)
  taskCount         Int          @default(0)
  completedCount    Int          @default(0)
  blockedCount      Int          @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  user            User       @relation("ReportOwner", fields: [userId], references: [id], onDelete: Restrict)
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentApprover User?      @relation("ReportApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)

  tasks         Task[]
  byProject     ReportProjectTotal[]
  trail         ReportTrailEntry[]
  notifications Notification[]

  @@unique([userId, isoYear, isoWeek])
  @@index([departmentId, status, weekStart])
  @@index([currentApproverId, status])
}

/// A report's cached hours for one project.
model ReportProjectTotal {
  reportId  String @db.Uuid
  projectId String @db.Uuid
  hours     Float  @default(0)
  taskCount Int    @default(0)

  report  WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([reportId, projectId])
  @@index([projectId])
}

/// One step in a report's approval history.
model ReportTrailEntry {
  id       Int         @id @default(autoincrement())
  reportId String      @db.Uuid
  action   TrailAction
  byUserId String      @db.Uuid
  at       DateTime    @db.Timestamptz(3)
  comment  String?

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  by     User         @relation(fields: [byUserId], references: [id], onDelete: Restrict)

  @@index([reportId, at])
  @@index([at])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  departmentId   String       @db.Uuid
  projectId      String       @db.Uuid
  date           DateTime     @db.Date
  details        String
  hours          Float?
  /// One of TASK_STATUSES in src/lib/constants.ts.
  status         String       @default("Completed")
  weeklyReportId String       @db.Uuid
  /// A copy of the weekly report's status, kept in step by the workflow, so the approval gate
  /// applies to task queries with one indexed filter.
  reportStatus   ReportStatus @default(DRAFT)
  /// "sync" for tasks written by the VS Code daily sync.
  source         TaskSource   @default(manual)
  /// For synced tasks, a hash of the details the sync last wrote. When the details no longer
  /// match it, the person has edited the task, and later syncs leave it alone.
  syncHash       String?
  syncedFrom     SyncOrigin?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  weeklyReport WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Restrict)

  @@index([departmentId, date])
  @@index([userId, date])
  @@index([projectId, date])
  @@index([weeklyReportId])
  @@index([departmentId, reportStatus, date])
}

model TaskTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  departmentId String   @db.Uuid
  projectId    String   @db.Uuid
  details      String
  hours        Float?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  recipientId  String           @db.Uuid
  departmentId String?          @db.Uuid
  type         NotificationType
  title        String
  message      String
  link         String?
  reportId     String?          @db.Uuid
  readAt       DateTime?        @db.Timestamptz(3)
  /// Set on reminders, so the same reminder is never sent to the same person twice.
  dedupeKey    String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  recipient  User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  report     WeeklyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  // Rows without a key never clash: PostgreSQL treats NULLs as distinct.
  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([departmentId, createdAt(sort: Desc)])
}

/// A personal token for tools outside the browser, such as the VS Code daily sync. Only its
/// SHA-256 hash is stored; the token itself is shown once, when it's created.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  /// The first characters of the token, so people can tell their tokens apart.
  prefix     String
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  /// "User", "Department", "Project" or "SiteSettings" (whose target is the Super Admin who saved).
  targetType String
  /// No foreign key: the log outlives what it describes.
  targetId   String   @db.Uuid
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt(sort: Desc)])
}

/// Fixed-window counters for sign-in and password limits.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

/// Organisation-wide switches a Super Admin sets on the Site settings page, one row per group.
/// See src/lib/site-settings/service.ts for the keys and the shape of each value.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
