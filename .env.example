# Copy to .env.local. Never commit real values.

# PostgreSQL. URL-encode special characters in the password (@ becomes %40).
# `docker compose up -d` starts one that matches this line.
DATABASE_URL="postgresql://postgres:worklog@127.0.0.1:5432/worklog?schema=public"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the app, used in email links and for Microsoft sign-in.
APP_URL="http://localhost:3000"

# Microsoft Entra ID sign-in. This is the only way to sign in, so all four are needed.
# ENTRA_TENANT_ID is your organisation's tenant id: only its accounts may sign in.
# ENTRA_REDIRECT_URI must be registered on the Entra app as a Web redirect URI. When it's empty,
# <APP_URL>/api/auth/sso/entra/callback is used.
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_TENANT_ID=""
ENTRA_REDIRECT_URI="http://localhost:3000/api/auth/sso/entra/callback"

# The people who run GET List, separated by commas. They are Super Admins from their first
# Microsoft sign-in. Everyone else who signs in waits for one of them to approve their account
# and give them a role on the Users page.
SUPER_ADMIN_EMAILS="you@your-organisation.com"

# Email through SendGrid. Without a key, emails are logged as failed and the app carries on.
# SENDGRID_FROM_EMAIL must be a sender verified in the SendGrid account.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="GET List <no-reply@example.com>"

# "Improve with AI". The app works without it.
ANTHROPIC_API_KEY=""

# Protects the reminders and dependency audit cron endpoints.
CRON_SECRET="replace-with-a-long-random-string"

# The daily dependency audit reads each project's package-lock.json from Bitbucket with this
# read-only token (scope: Repositories, Read). Without it, no project is audited.
# An access token needs no username. For an API token set the username to the Atlassian account's
# email address, and for an app password to the Bitbucket username.
BITBUCKET_TOKEN=""
BITBUCKET_USERNAME=""
