# Copy to .env.local. Never commit real values.

# Local Docker or `npm run db:dev`. Use an mongodb+srv:// URI for Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/worklog

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string
# Public URL of the app, used in email links.
APP_URL=http://localhost:3000

# Mailpit from docker-compose. The web UI is at http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="WorkLog <no-reply@worklog.local>"

# Phase 7: "Improve with AI". The app works without it.
ANTHROPIC_API_KEY=

# Phase 8: protects the reminders cron endpoint.
CRON_SECRET=replace-with-a-long-random-string
